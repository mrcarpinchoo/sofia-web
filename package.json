{
  "name": "sofia-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SOFIA kinematic lab: 3D simulation, joint filters and camera tracking in the browser.",
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "dev:phone": "vite --mode phone --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.169.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
